{
  "rules": {
    "fichasSIC": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["dpi", "nombreCompleto", "fechaIngreso"]
    },
    
    "fichasVehiculos": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["placa"]
    },
    
    "numerosExtorsivos": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["casoNo", "telefonoExtorsionista"]
    },
    
    "bibliotecaDocumentos": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },
    
    "usuariosSistema": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true",
      "$pushId": {
        "pass": {
          ".write": false,
          ".read": false
        },
        "authUid": {
          ".read": "auth != null"
        }
      }
    },
    
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}